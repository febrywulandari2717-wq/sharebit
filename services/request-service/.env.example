# Request Service - salin file ini menjadi .env
HOST=0.0.0.0
PORT=5002

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sharebite_request

# Path relatif terhadap folder request-service
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
JWT_ISSUER=sharebite-identity
JWT_AUDIENCE=sharebite-api

# Kunci antar-service (HARUS sama dengan service lain)
REQUEST_SERVICE_KEY=request-secret-key-2026
DONATION_SERVICE_KEY=donation-secret-key-2026

FOOD_SERVICE_URL=http://127.0.0.1:5001
HTTP_TIMEOUT_MS=5000

# Pembersihan otomatis (kedaluwarsa & pelepasan stok). 0 = nonaktif
RECONCILE_INTERVAL_SECONDS=60
