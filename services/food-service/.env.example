# Food Service - salin file ini menjadi .env
HOST=0.0.0.0
PORT=5001
FLASK_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sharebite_food

# Path relatif terhadap folder food-service
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
JWT_ISSUER=sharebite-identity
JWT_AUDIENCE=sharebite-api

# Harus sama dengan REQUEST_SERVICE_KEY di request-service dan donation-service
REQUEST_SERVICE_KEY=request-secret-key-2026

UPLOAD_DIR=uploads
MAX_CONTENT_LENGTH=2097152

# Untuk mengirim catatan audit aksi admin ke Donation Service
DONATION_SERVICE_URL=http://127.0.0.1:8003
DONATION_SERVICE_KEY=donation-secret-key-2026
