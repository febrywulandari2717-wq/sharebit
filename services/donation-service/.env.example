APP_NAME=ShareBite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5003
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sharebite_donation
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+00:00

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Path relatif terhadap folder donation-service
JWT_PRIVATE_KEY_PATH=../../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
JWT_ISSUER=sharebite-identity
JWT_AUDIENCE=sharebite-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Harus sama dengan service lain
DONATION_SERVICE_KEY=donation-secret-key-2026
REQUEST_SERVICE_URL=http://127.0.0.1:5002
